# WARNING: contains PUBLIC local-development credentials; see the HTTP Basic users section.
# Copy to .env and adjust. Never commit .env.

POSTGRES_DB=urlshortener
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=change-me

# Public base URL used to build short links returned by the API
APP_BASE_URL=http://localhost:8080

# HTTP Basic users (D3, D24, D50).
# WARNING: the hashes below are for LOCAL DEVELOPMENT ONLY. This repository is public, so the matching
# passwords are public too (admin: local-admin-password, user: local-user-password). Never use these
# credentials, or these hashes, in any shared or deployed environment. Generate your own there.
#
# password-hash is a BCrypt hash with cost 10, never a plaintext password, and has no "{bcrypt}" prefix.
# Generate one with:   htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n'
# Single-quote hash values: they contain '$', which the shell and Docker Compose would otherwise expand.
# Usernames: lowercase letters, digits, '.', '_', '-'; at most 100 characters.
# ..._PASSWORD_HASH and ..._PASSWORDHASH both bind; set only one (the PASSWORDHASH form wins if both are set).
APP_SECURITY_USERS_0_USERNAME=admin
APP_SECURITY_USERS_0_PASSWORD_HASH='$2y$10$JfTuuXi/V.jbellT6IDFa.y8a9RBE4DLwdOMnppbCey4ob39VQR2G'
APP_SECURITY_USERS_0_ROLE=ADMIN
APP_SECURITY_USERS_1_USERNAME=user
APP_SECURITY_USERS_1_PASSWORD_HASH='$2y$10$qBKF8PlAi6dX.GYtewDej.WZlVe91MmXuqW97Bcs1ZdprvTiIqIoW'
APP_SECURITY_USERS_1_ROLE=USER
